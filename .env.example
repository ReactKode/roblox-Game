# API Keys (optional - NexusAgent works fully offline with Ollama or LM Studio)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override settings
NEXUS_MODEL_BACKEND=auto        # auto | ollama | lmstudio | openai | anthropic
NEXUS_OLLAMA_MODEL=llama3.2
NEXUS_OLLAMA_URL=http://localhost:11434
NEXUS_LMSTUDIO_URL=http://localhost:1234/v1
NEXUS_DATA_DIR=./data
